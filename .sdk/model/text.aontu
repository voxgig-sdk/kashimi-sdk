# README wording — YOURS. The scaffold creates this file once and never
# overwrites it. A slot set here words the generated README files and the
# documentation over the same slot of main.kit.info.

# The spec's info.title is "Gatekeeper docs", Kashimi's internal service name.
# Its schemas carry no descriptions, so the entity descriptions come from
# Kashimi's documentation (docs.kashimi.tech).
main: kit: text: {
  title: 'Kashimi API'
  summary: 'Kashimi is an open-banking API for account-to-account payments: one API to hundreds of banks.'
  website: 'https://www.kashimi.tech'
  about_md: `**Credentials.** Kashimi uses OAuth 2.0 client credentials. Exchange your client ID
and secret for an access token, valid for 30 minutes, then pass the token as the \`apikey\`
option:

\`\`\`ts
import { KashimiSDK } from '@voxgig-sdk/kashimi-sdk'

// The Sandbox. Without \`base\` the SDK calls Production, https://api.kashimi.tech.
const base = 'https://api-sandbox.kashimi.tech'

// The token call is form-encoded, with HTTP Basic credentials, and the SDK
// sends it that way. The generated TokenCreateData type also requires the
// response's fields, hence the cast.
const auth = new KashimiSDK({ base })
const basic = Buffer.from(
  \`${process.env.KASHIMI_CLIENT_ID}:${process.env.KASHIMI_CLIENT_SECRET}\`).toString('base64')
const token = await auth.Token().create({
  grant_type: 'client_credentials',
  scope: 'payments:read payments:write providers:read',
  authorization: 'Basic ' + basic,
} as any)

// Every other call sends the token as \`Authorization: Bearer <token>\`.
const apikey = token.data().access_token
const client = new KashimiSDK({ base, apikey })

const providers = await client.Provider().list()
const payment = await client.Payment().load({ id: 'your-payment-id' })
console.log(payment.data())
\`\`\`

The same exchange with curl:

\`\`\`bash
curl --request POST "https://api-sandbox.kashimi.tech/api/v1/auth/token" \\
  --user "$KASHIMI_CLIENT_ID:$KASHIMI_CLIENT_SECRET" \\
  --data-urlencode "grant_type=client_credentials" \\
  --data-urlencode "scope=payments:read payments:write providers:read"
\`\`\`

**The token call.** Kashimi's token call takes a form-encoded body and HTTP Basic
credentials. Stock sdkgen sends JSON with the client's bearer token, so this SDK's request
templates, in \`.sdk/tm\`, send a body the definition declares form-encoded as a form, and
send a credential the call passes itself, such as \`authorization\` above, as that header.

**Scope.** Every operation in Kashimi's published definition is here except the three it
tags "Internal Endpoints". The \`callback\`, \`client_jwk\`, \`sender_account\`,
\`psu_provided_data\`, \`sca_method\`, \`sca_data\`, \`confirmation_data\` and
\`consent_status\` entities are the routes of Kashimi's hosted payment flow.
\`Country().list()\` returns one entity per country, and each entity's data is the bare
country code, such as \`'DE'\`.`
  entity_desc: {
    token: 'A short-lived access token, issued for your client credentials.'
    payment: 'A bank payment: initiate one, list yours, load one by id, or cancel one in the hosted flow.'
    followup: 'A follow-up for a payment, created at its provider.'
    report: 'A reporting summary of one payment: amount, status, provider, sender, recipient and remittance information.'
    payment_status: 'The status of a payment: its full history, or the latest.'
    provider: 'A bank or payment provider, with its supported payment schemes and required fields.'
    subsidiary: 'A regional or subsidiary institution of a provider.'
    country: 'A country where Kashimi supports payment providers.'
    hosted_ui_customization: 'The customizations of the hosted payment UI for a client.'
    healthcheck: 'The status of the API.'
    callback: 'The bank redirect back into the hosted payment flow.'
    client_jwk: 'The JSON Web Key Set of a client at a provider.'
    sender_account: 'The sender accounts offered in the hosted payment flow, and the one chosen.'
    psu_provided_data: 'Data the payer provides in the hosted payment flow.'
    sca_method: 'The strong customer authentication methods of a decoupled payment, and the one chosen.'
    sca_data: 'The strong customer authentication data of a decoupled payment.'
    confirmation_data: 'The confirmation data of a decoupled payment.'
    consent_status: 'The consent status of a decoupled payment.'
  }
}
