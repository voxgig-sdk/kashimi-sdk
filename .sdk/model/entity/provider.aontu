# Entity: provider

main: kit: entity: provider: {

  alias: field: {}

  fields: {
    bic: {
      h: "Bic"
      n: "bic"
      r: true
      sh: "BIC code of the provider"
      t: "`$STRING`"
    }
    countryCode: {
      h: "Country Code"
      n: "countryCode"
      r: true
      sh: "Country code of the provider."
      t: "`$STRING`"
    }
    hasSubsidiaries: {
      h: "Has Subsidiaries"
      n: "hasSubsidiaries"
      r: true
      sh: "Whether the provider has subsidiaries."
      t: "`$BOOLEAN`"
    }
    iconUrl: {
      h: "Icon Url"
      n: "iconUrl"
      r: true
      sh: "URL of the provider's icon."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the provider."
      t: "`$STRING`"
    }
    logoUrl: {
      h: "Logo Url"
      n: "logoUrl"
      r: true
      sh: "URL of the provider's logo."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Name of the provider."
      t: "`$STRING`"
    }
    paymentSchemes: {
      h: "Payment Schemes"
      n: "paymentSchemes"
      r: true
      sh: "Array of payment schemes that we support for this provider."
      t: "`$ARRAY`"
    }
    requiredPaymentFields: {
      h: "Required Payment Fields"
      n: "requiredPaymentFields"
      r: true
      sh: "Array of required payment fields for this provider."
      t: "`$ARRAY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "provider"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v1/capabilities/providers"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "authorization"
                or: "Authorization"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "cursor"
                or: "cursor"
                r: false
                t: "`$OBJECT`"
              }
              {
                k: "query"
                n: "filter"
                or: "filters"
                r: false
                t: "`$OBJECT`"
              }
            ]
          }
          m: "GET"
          o: "/api/v1/capabilities/providers"
          q: {
            exist: [
              "authorization"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "capabilities"
            }
            {
              lit: "providers"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.items`"
          }
        }
      ]
    }
  }



}
