# Feature: conform — send and read what Kashimi's definition declares, where
# the stock sdkgen pipeline does not yet (voxgig/sdkgen#465).
#
# A CUSTOM feature, provided by this project's own sdkgen package (ext/).
# It does two things, each driven by the model rather than by entity names
# in code:
#
#   form        A point whose request body the definition declares as
#               application/x-www-form-urlencoded is sent form-encoded, with
#               that content type. The stock pipeline sends every object body
#               as JSON. Kashimi's token call, POST /api/v1/auth/token, is one.
#   credential  A credential header the operation declares as a parameter, and
#               the call passes itself, is sent as passed. The stock pipeline
#               replaces it with the client's `Bearer <apikey>`, or removes it
#               when there is no apikey. The token call takes
#               `Authorization: Basic <base64 clientId:clientSecret>` this way.
#
# Every implementation records `{ form, credential }` counts on the client as
# `_conform`. Like every sdkgen feature it runs only when the caller turns it
# on: options.feature.conform.active = true.

main: kit: feature: conform: {

  name: key()
  title: "Conform"
  description: "Form-encoded bodies and call credentials, as the definition declares"
  version: '0.1.0'
  active: true
  base: 'BASE'
  transport: 'none'

  config: {
    # Off until the caller turns it on, like every sdkgen feature: a feature
    # runs only when options.feature names it.
    options: {
      active: false
    }
  }

  hook: {
    PreRequest: { active: true }
  }
}
